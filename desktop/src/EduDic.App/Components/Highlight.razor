@* 예문 속 낱말만 형광펜 *@
@foreach (var (t, match) in DictView.Highlight(Text, Word))
{
    if (match)
    {
        <mark>@t</mark>
    }
    else
    {
        <span>@t</span>
    }
}

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string Word { get; set; } = "";
}
