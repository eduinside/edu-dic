# 이 파일을 .dev.vars 로 복사한 뒤 실제 값을 채워 넣으세요.
#   cp .dev.vars.example .dev.vars
# .dev.vars 는 .gitignore 에 있어 커밋되지 않습니다.

# 국립국어원 한국어기초사전(krdict) 오픈 API 인증키 (32자리 hex)
KRDICT_API_KEY=

# 한국민족문화대백과사전(한국학중앙연구원) API 키 — krdict 미수록 텍스트/이미지 보완(D20). 선택값.
ENCYKOREA_API_KEY=

# 네이버 이미지 검색(NCP API Gateway) — krdict·encykorea 둘 다 이미지가 없을 때만 쓰는 최종 폴백(D24).
# 변수명이 요청 헤더명 그대로다(코드에서 대괄호로 접근). 선택값.
X-NCP-APIGW-API-KEY-ID=
X-NCP-APIGW-API-KEY=

# AI 게이트웨이(byeduin-labs 조직 크레딧, 사실상 무료) — 오타 교정·쉬운 말 변환·관련어 제안(D17)에 사용.
# 선택값: 없으면 세 기능만 조용히 생략되고 사전 조회 자체는 항상 정상 동작.
TIMELY_API_KEY=
# GEMINI_API_KEY=   # (선택) Timely 실패 시 직접 폴백. 보통 안 넣어도 됨.
