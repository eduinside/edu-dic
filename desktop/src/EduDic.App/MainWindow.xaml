<Window x:Class="EduDic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:EduDic.App"
        xmlns:ui="clr-namespace:EduDic.App.Components"
        Title="어린이 쉬운 사전 데스크탑" Width="500" Height="92"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True" Icon="app.ico">
    <!-- 옛 Tauri 창과 같게: 테두리 없는 투명 창, 항상 위, 작업 표시줄 없음. 모양은 화면(app.css)이 그린다 -->
    <Grid>
        <local:EmbeddedBlazorWebView x:Name="WebView" HostPage="wwwroot\index.html" Services="{DynamicResource services}">
            <local:EmbeddedBlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type ui:Main}" />
            </local:EmbeddedBlazorWebView.RootComponents>
        </local:EmbeddedBlazorWebView>
    </Grid>
</Window>
