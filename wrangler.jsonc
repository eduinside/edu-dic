{
  // 어린이 쉬운 사전 — Cloudflare Pages (정적 + Functions).
  // D1은 신규 생성하지 않고 공유 'edu-link-db' 사용(계획서 D12). 테이블은 edudic_ 접두어(db/schema.sql).
  "$schema": "node_modules/wrangler/config-schema.json",
  // GitHub(eduinside/edu-dic)에 연결된 Pages 프로젝트(2026-10-09 기존 직접 업로드 프로젝트에 Git 연결).
  // main에 푸시하면 Cloudflare가 빌드해 운영(dic.dgedu.link)에 바로 배포한다.
  "name": "edu-dic",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",

  // 무료 플랜 한국 트래픽이 먼 엣지에서 실행되는 것을 실측(2026-10-09, loc=KR인데 colo=CDG·DFW·DUB·MIA·NRT로 바뀜).
  // krdict·네이버·Timely가 모두 한국이라 Functions를 AWS 서울 리전 근처 데이터센터에서 실행한다(placement hint).
  // Smart Placement("mode": "smart")는 트래픽이 적어 15분 넘게 local-*에 머물러 바꿨다. 정적 파일은 _routes.json으로
  // Functions를 거치지 않으므로 계속 사용자 가까운 엣지에서 나간다. 확인: 응답 헤더 cf-placement. docs/perf-plan.md §2.1
  // Cloudflare Pages 빌드 환경의 wrangler는 구버전이라 "mode"가 없으면 거부한다(빌드 로그: "placement.mode" is a required field).
  "placement": { "mode": "targeted", "region": "aws:ap-northeast-2" },

  // 공유 D1 (D12) — edu-link/edu-kit와 동일 DB. 테이블만 edudic_ 접두어로 분리.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edu-link-db",
      "database_id": "e5fa6f54-6063-48f9-9cf3-0517381dd005"
    }
  ],

  // 데스크탑 앱 설치파일 및 업데이트 배포용 R2 버킷
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "edu-dic-downloads"
    }
  ]


  // 비밀값(KRDICT_API_KEY, ENCYKOREA_API_KEY, X-NCP-APIGW-API-KEY-ID/KEY, TIMELY_API_KEY 등)은
  // 코드/설정에 넣지 않는다:
  //   - 로컬:  .dev.vars 파일(gitignore됨)
  //   - 운영:  wrangler pages secret put <이름>  또는 CF 대시보드 환경변수
  // Preview 환경은 프로덕션 edu-link-db 오염 방지를 위해 별도 dev D1 바인딩 권장.
}
