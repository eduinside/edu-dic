{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "어린이 쉬운 사전 데스크탑",
  "version": "0.2.3",
  "identifier": "link.dgedu.dic.desktop",







  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "어린이 쉬운 사전 데스크탑",
        "width": 500,
        "height": 92,
        "minWidth": 380,
        "minHeight": 92,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": true



      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": ["Korean"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4NTZGQjg1OTIzRkM1QkQKUldTOXhUK1NoZnRXbU5zT2xwVGpnQk9yL1o1Tmp6TkV6NW16SmF3VjdYSkFBL3Yvc01VZGZUVWkK",
      "endpoints": ["https://dic.dgedu.link/api/download/desktop-latest.json"]
    }

  }


}
