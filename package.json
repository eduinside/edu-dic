{
  "name": "edu-dic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute edu-link-db --local --file=db/schema.sql",
    "db:remote": "wrangler d1 execute edu-link-db --remote --file=db/schema.sql",
    "pages:dev": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=edu-dic-web"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.14",
    "wrangler": "^4.0.0",
    "zod": "^3.24.0"
  }
}
